# Managed publish — local / host env template
# Copy to .env.local (never commit secrets).

# Canonical origin for the shared deploy (demo catalog + managed path surface)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Lead delivery (required for managed / production-like hosts)
# LEAD_WEBHOOK_URL=
# LEAD_WEBHOOK_TOKEN=

# Prospect demo fleet (/sites/*) may log-only under NODE_ENV=production only if set:
# ALLOW_LEAD_DEMO_MODE=1

# Force fail-closed delivery even in development:
# MANAGED_REQUIRE_DELIVERY=1

# Hostname → siteId map (comma-separated). Overrides/extends content/managed/domains.json
# MANAGED_DOMAIN_MAP=pilot.example.com:site_pilot_craft

# Operator publish / rollback / lead retry
# OPERATOR_PUBLISH_TOKEN=

# Optional lead file-store root (default: site/.data/leads — ephemeral on Vercel)
# LEAD_STORE_DIR=

# --------------------
# Durable active-revision state (Vercel Edge Config)
# --------------------
# When configured, operator rollback persists across serverless instances.
# Without these, rollback is process-local only (single-instance dev).

# GLOBAL_CONFIG — auto-populated when you link an Edge Config to the Vercel project.
# Value: connection string like https://edge-config.vercel.com/ecfg_xxx?token=yyy
# GLOBAL_CONFIG=

# EDGE_CONFIG — legacy alias for GLOBAL_CONFIG (same behavior, either works).
# EDGE_CONFIG=

# EDGE_CONFIG_ID — Edge Config store ID (ecfg_...) for write operations.
# Find in Vercel Dashboard → Storage → Edge Config → Settings.
# EDGE_CONFIG_ID=

# VERCEL_API_TOKEN — Vercel API token with read/write access to the Edge Config.
# Create at https://vercel.com/account/tokens (scope: team, or account for hobby).
# VERCEL_API_TOKEN=

# VERCEL_TEAM_ID — (optional) Team ID if Edge Config belongs to a team.
# VERCEL_TEAM_ID=

# --------------------
# Durable lead storage (Supabase)
# --------------------
# When configured, leads persist to Supabase managed_leads table across cold starts.
# Without these, leads use ephemeral /tmp + memory storage only.

# SUPABASE_URL — Supabase project URL (e.g. https://xxx.supabase.co)
# SUPABASE_URL=

# SUPABASE_SERVICE_ROLE_KEY — Service role key for server-only writes (never expose to client).
# Create in Supabase Dashboard → Settings → API → service_role key.
# SUPABASE_SERVICE_ROLE_KEY=
