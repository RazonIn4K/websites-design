# Managed publish — local / host env template
# Copy to .env.local (never commit secrets).

# Canonical origin for the shared deploy (demo catalog + managed path surface)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Lead delivery (required for managed / production-like hosts)
# LEAD_WEBHOOK_URL=
# LEAD_WEBHOOK_TOKEN=

# Prospect demo fleet (/sites/*) may log-only under NODE_ENV=production only if set:
# ALLOW_LEAD_DEMO_MODE=1

# Force fail-closed delivery even in development:
# MANAGED_REQUIRE_DELIVERY=1

# Hostname → siteId map (comma-separated). Overrides/extends content/managed/domains.json
# MANAGED_DOMAIN_MAP=pilot.example.com:site_pilot_craft

# Operator publish / rollback / lead retry
# OPERATOR_PUBLISH_TOKEN=

# Optional lead file-store root (default: site/.data/leads — ephemeral on Vercel)
# LEAD_STORE_DIR=
